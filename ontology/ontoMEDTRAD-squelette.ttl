# ============================================================================
# PROPRIÉTÉS OBJET — niveau supérieur (fig. 5.17)
# Domaines/plages : inférés des noms et du contexte ; « à valider » sinon.
# ============================================================================
:aDecrireMaladie a owl:ObjectProperty ; rdfs:label "a décrire maladie"@fr ; rdfs:domain :PMT ; rdfs:range :Maladie ; rdfs:comment "Source : fig. 5.17."@fr .
:aDetenirRecette a owl:ObjectProperty ; rdfs:label "a détenir recette"@fr ; rdfs:domain :PMT ; rdfs:range :Recette ; rdfs:comment "Source : fig. 5.17."@fr .
:aDetenirRemede a owl:ObjectProperty ; rdfs:label "a détenir remède"@fr ; rdfs:domain :PMT ; rdfs:range :Remede ; rdfs:comment "Source : fig. 5.17."@fr .
:aEtreLocaliserMaladiePartieAnatomieHumaine a owl:ObjectProperty ; rdfs:label "être localiser maladie partie anatomie humaine"@fr ; rdfs:domain :Maladie ; rdfs:range :AnatomiePartieHumaine ; rdfs:comment "Source : fig. 5.17."@fr .
:aEtreLocalitedePays a owl:ObjectProperty ; rdfs:label "être localité de pays"@fr ; rdfs:domain :Localite ; rdfs:range :Pays ; rdfs:comment "Source : fig. 5.17."@fr .
:aExercerPmtLocalite a owl:ObjectProperty ; rdfs:label "exercer PMT localité"@fr ; rdfs:domain :PMT ; rdfs:range :Localite ; rdfs:comment "Source : fig. 5.17."@fr .
:aExercerPmtPays a owl:ObjectProperty ; rdfs:label "exercer PMT pays"@fr ; rdfs:domain :PMT ; rdfs:range :Pays ; rdfs:comment "Source : fig. 5.17."@fr .
:aPourBaseDeRM a owl:ObjectProperty ; rdfs:label "a pour base de ressource médicinale"@fr ; rdfs:domain :Ingredient ; rdfs:range :RM ; rdfs:comment "Source : fig. 5.17 ; relation ternaire Recette-Plante-Partie (fig. 6.15)."@fr .
