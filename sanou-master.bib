@article{zerbo_contribution_2008-3,
	title = {Contribution à la connaissance des plantes médicinales utilisées dans les soins infantiles en pays {San}, au {Burkina} {Faso}},
	volume = {1},
	url = {https://www.researchgate.net/publication/272442118_Contribution_a_la_connaissance_des_plantes_medicinales_utilisees_dans_les_soins_infantiles_en_pays_San_au_Burkina_Faso},
	doi = {10.4314/ijbcs.v1i3.39704},
	abstract = {La présente étude contribue à la connaissance des plantes médicinales et des recettes médicamenteuses utilisées dans les soins infantiles au Pays San, situé au Nord-ouest du Burkina Faso. A la suite d{\textbackslash}'enquêtes ethnobotaniques, 50 tradipraticiens de santé, ayant au moins 15 ans d{\textbackslash}'expérience ont été interrogés. La technique utilisée était l{\textbackslash}'entretien semi-directif à partir d{\textbackslash}'un questionnaire élaboré. Au total 79 espèces médicinales ont été recensées, reparties en 69 genres et 34 familles dont les mieux représentées sont les Ceasalpiniaceae (7 genres et 9 espèces), les Mimosaceae (6 genres et 9 espèces), les Combretaceae (4 genres et 8 espèces) et les Anacardiaceae (4 genres et 5 espèces). Quelques 90\% de ces espèces sont des plantes ligneuses (arbres, arbustes, lianes et sous-arbrisseaux). Isolées ou en association, ces plantes entrent dans la formulation de 167 recettes médicamenteuses, et les feuilles constituent les principaux organes sollicités. La décoction et la boisson sont prédominantes pour l{\textbackslash}'acquisition et l{\textbackslash}'administration des remèdes respectivement. Le paludisme et la diarrhée sont les plus cités sur les 34 maladies infantiles recensées.},
	journal = {International Journal of Biological and Chemical Sciences},
	author = {Zerbo, Patrice and Millogo-Rasolodimey, J and Nacoulma-Ouerdraogo, O and Van Damme, Patrick},
	month = jan,
	year = {2008},
}

