# ============================================================================
# ontoMEDTRAD — reconstruction documentée (v0.2)
# ----------------------------------------------------------------------------
# Source : KOUAME Appoh, « Système de gestion de la médecine traditionnelle
# dans une plateforme web social et sémantique : une approche basée sur une
# ontologie visuelle », thèse de doctorat, Université Gaston Berger de
# Saint-Louis (Sénégal), 14 avril 2018 (HAL : tel-01842116).
#
# IRI d'origine (capture Protégé, fig. 5.15) :
#   http://www.semanticweb.org/ontologies/2015/11/OntoMedTrad.owl
# Fichier d'origine (chemin vu dans la capture) :
#   F:\Thèses 2016 INFO\limics\OntoMedTrad.owl
#
# MÉTHODE DE RECONSTRUCTION :
#   * Classes et propriétés extraites par OCR des captures d'écran Protégé
#     (figures 5.15, 5.16, 5.17, 5.18, 5.19, 5.20, p. 130-134 du PDF),
#     du diagramme de classes (fig. 5.13 + annexe 2, p. 216 du PDF),
#     et des tableaux 5.5, 5.6, 5.7, 6.9, 6.10, 6.11, 6.14, 6.18.
#   * Chaque entité porte en commentaire sa source (figure/tableau).
#   * Les domaines/plages non attestés sont marqués « à valider ».
#
# LIMITES :
#   * Les captures montrent des vues défilées : la liste complète (144
#     concepts, 76 object properties, 16 data properties, 789 individus,
#     2734 axiomes, ALCHOIQ(D) — tableau 5.22) n'est pas intégralement
#     visible. Les éléments manquants sont à compléter dans Protégé.
#   * Les individus (789) ne sont pas reproduits ici.
# ============================================================================

@prefix :        <http://www.semanticweb.org/ontologies/2015/11/OntoMedTrad.owl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================================
# En-tête de l'ontologie
# ============================================================================
<http://www.semanticweb.org/ontologies/2015/11/OntoMedTrad.owl>
    a owl:Ontology ;
    dcterms:title "ontoMEDTRAD — reconstruction documentée (v0.2)"@fr ;
    dcterms:description "Reconstruction de l'ontologie ontoMEDTRAD (Kouamé, 2018) par OCR des captures Protégé de la thèse. Liste des classes et propriétés aussi complète que le permettent les vues visibles ; à compléter et valider dans Protégé."@fr ;
    dcterms:source "KOUAME Appoh, thèse de doctorat, Université Gaston Berger de Saint-Louis, 14 avril 2018 (HAL : tel-01842116)" ;
    owl:versionInfo "0.2 — reconstruction OCR, 2026-10-10" .

# ============================================================================
# CLASSES — personnes et acteurs (fig. 5.15, 5.16, 5.20, annexe 2)
# ============================================================================
:Personne a owl:Class ; rdfs:label "Personne"@fr ; rdfs:comment "Source : fig. 5.15, 5.20."@fr .
:Patient a owl:Class ; rdfs:subClassOf :Personne ; rdfs:label "Patient"@fr ; rdfs:comment "Source : fig. 5.15, annexe 2."@fr .
:PMT a owl:Class ; rdfs:subClassOf :Personne ; rdfs:label "Praticien de la médecine traditionnelle (PMT)"@fr ; rdfs:comment "Source : fig. 5.15, 5.16 (120 individus), annexe 2."@fr .
:EntourageHumain a owl:Class ; rdfs:subClassOf :Personne ; rdfs:label "Entourage humain"@fr ; rdfs:comment "Source : fig. 5.15."@fr .
:PartenaireNonPMT a owl:Class ; rdfs:subClassOf :Personne ; rdfs:label "Partenaire non PMT"@fr ; rdfs:comment "Source : annexe 2."@fr .
:GroupeAssociatif a owl:Class ; rdfs:label "Groupe associatif (de PMT)"@fr ; rdfs:comment "Source : annexe 2."@fr .
:EthniePMT a owl:Class ; rdfs:label "Ethnie du PMT"@fr ; rdfs:comment "Source : annexe 2."@fr .
:NiveauEtudePMT a owl:Class ; rdfs:label "Niveau d'étude du PMT"@fr ; rdfs:comment "Source : annexe 2."@fr .
:PMTExperiences a owl:Class ; rdfs:label "Expériences du PMT"@fr ; rdfs:comment "Source : annexe 2."@fr .
:ProfessionPMT a owl:Class ; rdfs:label "Profession du PMT"@fr ; rdfs:comment "Source : fig. 5.16 (11 individus)."@fr .
:CentreDuPMT a owl:Class ; rdfs:label "Centre du PMT"@fr ; rdfs:comment "Source : annexe 2."@fr .
:CentreDeSoins a owl:Class ; rdfs:label "Centre de soins de santé"@fr ; rdfs:comment "Source : fig. 5.15 ; concept secondaire (tab. 5.5)."@fr .
:MaterielUtilise a owl:Class ; rdfs:label "Matériel utilisé"@fr ; rdfs:comment "Source : fig. 5.15, 5.16 (20 individus), 5.20."@fr .
:MaterielSpecifique a owl:Class ; rdfs:label "Matériel spécifique"@fr ; rdfs:comment "Source : fig. 5.16 (1 individu)."@fr .

# ============================================================================
# CLASSES — ressources médicinales (RM) et parties (fig. 5.15, 5.16, 5.20)
# ============================================================================
:RM a owl:Class ; rdfs:label "Ressource médicinale (RM)"@fr ; rdfs:comment "Source : fig. 5.15 ; concept majeur (tab. 5.5)."@fr .
:Plante a owl:Class ; rdfs:subClassOf :RM ; rdfs:label "Plante"@fr ; rdfs:comment "Source : fig. 5.16 (87 individus) ; définition thèse § 5.7.3."@fr .
:Animal a owl:Class ; rdfs:subClassOf :RM ; rdfs:label "Animal"@fr ; rdfs:comment "Source : fig. 5.16 (11 individus pour Mineral ; Animal non visible)."@fr .
:Mineral a owl:Class ; rdfs:subClassOf :RM ; rdfs:label "Minéral"@fr ; rdfs:comment "Source : fig. 5.16 (11 individus)."@fr .
:CategoriePlanteMedicinale a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Catégorie de plante médicinale"@fr ; rdfs:comment "Source : fig. 5.15."@fr .
:GenrePlante a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Genre de plante"@fr ; rdfs:comment "Source : fig. 5.20."@fr .
:OrdrePlante a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Ordre de plante"@fr ; rdfs:comment "Source : fig. 5.20."@fr .
:FamillePlante a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Famille de plante"@fr ; rdfs:comment "Inféré de aPourFamillePlante (fig. 5.17) ; à valider."@fr .
:EmbranchementAnimal a owl:Class ; rdfs:subClassOf :Animal ; rdfs:label "Embranchement animal"@fr ; rdfs:comment "Source : fig. 5.15."@fr .
:OrdreAnimal a owl:Class ; rdfs:subClassOf :Animal ; rdfs:label "Ordre animal"@fr ; rdfs:comment "Source : fig. 5.20."@fr .

:PartieDeRM a owl:Class ; rdfs:label "Partie de ressource médicinale (PRM)"@fr ; rdfs:comment "Source : fig. 5.15, 5.20 ; concept majeur (tab. 5.5)."@fr .
:PartieDePlante a owl:Class ; rdfs:subClassOf :PartieDeRM ; rdfs:label "Partie de plante"@fr ; rdfs:comment "Source : fig. 5.16 (15 individus)."@fr .
:PartieDeAnimal a owl:Class ; rdfs:subClassOf :PartieDeRM ; rdfs:label "Partie d'animal"@fr ; rdfs:comment "Source : fig. 5.16 (23 individus)."@fr .
:PartieDeMineral a owl:Class ; rdfs:subClassOf :PartieDeRM ; rdfs:label "Partie de minéral"@fr ; rdfs:comment "Source : fig. 5.16 (non visible)."@fr .
:Parties a owl:Class ; rdfs:subClassOf :PartieDeRM ; rdfs:label "Parties"@fr ; rdfs:comment "Source : annexe 2 ; à valider."@fr .

# --- Neuf parties de plante utilisées (thèse § 5.7.3 et ch. 6) ---
:Feuille a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Feuille"@fr ; rdfs:comment "Source : thèse § 5.7.3."@fr .
:Fruit a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Fruit"@fr .
:Fleur a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Fleur"@fr .
:Racine a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Racine"@fr .
:Tronc a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Tronc"@fr ; rdfs:comment "Partie principale de la tige (thèse § 5.7.3)."@fr .
:EcorceDeTronc a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Écorce de tronc"@fr .
:EcorceDeRacine a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Écorce de racine"@fr .
:Seve a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Sève"@fr .
:PlanteEntiere a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Plante entière"@fr .

# --- Types de plante : arbre, arbuste, palme, herbe, liane (thèse § 5.7.3) ---
:Arbre a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Arbre"@fr ; rdfs:comment "Plante lignifiée terrestre à tronc portant des branches ramifiées (thèse § 5.7.3)."@fr .
:Arbuste a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Arbuste"@fr .
:Palme a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Palme"@fr .
:Herbe a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Herbe"@fr .
:Liane a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Liane"@fr .

