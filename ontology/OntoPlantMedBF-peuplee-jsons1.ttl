# ============================================================================
# OntoPlantMedBF — ONTOLOGIE DES PLANTES MÉDICINALES DU BURKINA FASO
# ----------------------------------------------------------------------------
# Résultat de la phase 4 : OntoPlantMedBF, dérivée d'ontoMEDTRAD (Kouamé, 2018) et adaptée au contexte des
# plantes médicinales du Burkina Faso.
#   = ONTOLOGIE CONSERVÉE (voir ontoMEDTRAD-conserve.ttl)
#   + concepts pertinents du contexte ethnobotanique burkinabè, notamment
#     ceux du schéma ontopharma-bf.ttl (classes et propriétés uniquement).
#   + provenance généralisée reliant toute ressource du graphe à sa source.
#
# Les ajouts couvrent maladies, noms vernaculaires, usages, préparations,
# niveaux de preuve, sources, phytochimie et toxicologie.
#
# Version 4.0 : le schéma (v3.1) est complété (modes d'administration et de
# préparation, propriétés de posologie) et PEUPLÉ avec les individus extraits
# de 10 documents scientifiques (voir section INDIVIDUS en fin de fichier).
#
# Source : KOUAME Appoh, thèse de doctorat, Université Gaston Berger de
# Saint-Louis (Sénégal), 14 avril 2018 (HAL : tel-01842116).
# ============================================================================

@prefix :        <http://www.semanticweb.org/ontologies/2026/11/OntoPlantMedBF.owl#> .
@prefix ontomedtrad: <http://www.semanticweb.org/ontologies/2015/11/OntoMedTrad.owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================================
# En-tête de l'ontologie
# ============================================================================
<http://www.semanticweb.org/ontologies/2026/11/OntoPlantMedBF.owl>
    a owl:Ontology ;
    dcterms:title "OntoPlantMedBF — Ontologie des plantes médicinales du Burkina Faso"@fr ;
    dcterms:description "OntoPlantMedBF est une ontologie des plantes médicinales du Burkina Faso, dérivée d'ontoMEDTRAD (Kouamé, 2018) : concepts conservés, classes et propriétés propres, et individus issus exclusivement de la littérature scientifique (10 documents)."@fr ;
    dcterms:source "KOUAME Appoh, thèse de doctorat, Université Gaston Berger de Saint-Louis, 14 avril 2018 (HAL : tel-01842116)" ;
    prov:wasDerivedFrom <http://www.semanticweb.org/ontologies/2015/11/OntoMedTrad.owl> ;
    owl:versionInfo "4.0 — peuplement à partir de 10 sources, modes d'administration et de préparation, 2026-11-05" .

# ============================================================================
# ─────────────────────────── PARTIE CONSERVÉE ───────────────────────────────
# ============================================================================

# --- Classes conservées : plantes, taxonomie et parties ---
:Plante a owl:Class ; rdfs:label "Plante"@fr ; rdfs:comment "Conservée."@fr .
:Arbre a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Arbre"@fr .
:Arbuste a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Arbuste"@fr .
:Palme a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Palme"@fr .
:Herbe a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Herbe"@fr .
:Liane a owl:Class ; rdfs:subClassOf :Plante ; rdfs:label "Liane"@fr .
:FamillePlante a owl:Class ; rdfs:label "Famille de plante"@fr .
:GenrePlante a owl:Class ; rdfs:label "Genre de plante"@fr .
:OrdrePlante a owl:Class ; rdfs:label "Ordre de plante"@fr .
:PartieDePlante a owl:Class ; rdfs:label "Partie de plante"@fr .
:Feuille a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Feuille"@fr .
:Fruit a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Fruit"@fr .
:Fleur a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Fleur"@fr .
:Racine a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Racine"@fr .
:Tronc a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Tronc"@fr .
:EcorceDeTronc a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Écorce de tronc"@fr .
:EcorceDeRacine a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Écorce de racine"@fr .
:Seve a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Sève"@fr .
:PlanteEntiere a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Plante entière"@fr .

# --- Classes conservées : maladie, préparation, localisation, sources ---
:Maladie a owl:Class ; rdfs:label "Maladie"@fr ; rdfs:comment "Conservée."@fr .
:CategorieMaladieCIM10 a owl:Class ; rdfs:subClassOf :Maladie ; rdfs:label "Catégorie de maladie CIM-10"@fr .
:TypeMaladieCIM10 a owl:Class ; rdfs:subClassOf :Maladie ; rdfs:label "Type de maladie CIM-10"@fr .
:ModeDePreparation a owl:Class ; rdfs:label "Mode de préparation"@fr .
:ModeDePreparatRecetPlante a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Mode de préparation de recette à base de plante"@fr .
:Sechage a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Séchage"@fr .
:Localite a owl:Class ; rdfs:label "Localité"@fr .
:Pays a owl:Class ; rdfs:subClassOf :Localite ; rdfs:label "Pays"@fr .
:Region a owl:Class ; rdfs:subClassOf :Localite ; rdfs:label "Région"@fr .
:ReferenceScientifique a owl:Class ; rdfs:label "Référence scientifique"@fr .

# --- Propriétés objet conservées ---
:aPourFamillePlante a owl:ObjectProperty ; rdfs:label "a pour famille de plante"@fr ; rdfs:domain :Plante ; rdfs:range :FamillePlante .
:aPourGenrePlante a owl:ObjectProperty ; rdfs:label "a pour genre de plante"@fr ; rdfs:domain :Plante ; rdfs:range :GenrePlante .
:aPourHabitatLocalite a owl:ObjectProperty ; rdfs:label "a pour habitat localité"@fr ; rdfs:domain :Plante ; rdfs:range :Localite .
:aPourCategoriMaladie a owl:ObjectProperty ; rdfs:label "a pour catégorie de maladie"@fr ; rdfs:domain :Maladie ; rdfs:range :CategorieMaladieCIM10 .
:aEtreLocalitedePays a owl:ObjectProperty ; rdfs:label "être localité de pays"@fr ; rdfs:domain :Localite ; rdfs:range :Pays .

# --- Propriétés de données conservées ---
:aPourNomScientifique a owl:DatatypeProperty ; rdfs:label "a pour nom scientifique"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string .
:aPourNomBotanique a owl:DatatypeProperty ; rdfs:label "a pour nom botanique"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string .
:aPourSynonymePlante a owl:DatatypeProperty ; rdfs:label "a pour synonyme (plante)"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string .
:aPourNomEnLangueOfficelle a owl:DatatypeProperty ; rdfs:label "a pour nom en langue officielle"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string .
:aCoordoneesGPS a owl:DatatypeProperty ; rdfs:label "a pour coordonnées GPS"@fr ; rdfs:domain :Localite ; rdfs:range xsd:string .

# ============================================================================
# ─────────────────────────── PARTIE AJOUTÉE ─────────────────────────────────
# ============================================================================

# --- Classes ajoutées (contexte burkinabè) ---
:MaladieSpecifiqueBF a owl:Class ; rdfs:subClassOf :Maladie ; rdfs:label "Maladie spécifique du Burkina Faso"@fr ; rdfs:comment "Ajoutée : pathologies documentées par la littérature locale (paludisme, onchocercose, méningite...)."@fr .
:NomVernaculaire a owl:Class ; rdfs:label "Nom vernaculaire"@fr ; rdfs:comment "Ajoutée : désignations des plantes dans les langues du pays (mooré, dioula, fulfuldé)."@fr .
:RegionBF a owl:Class ; rdfs:subClassOf :Region ; rdfs:label "Région du Burkina Faso"@fr ; rdfs:comment "Ajoutée : découpage territorial du pays."@fr .
:NiveauDePreuve a owl:Class ; rdfs:label "Niveau de preuve"@fr ; rdfs:comment "Ajoutée : catégories de preuve rapportées par les sources (traditionnel, in vitro, in vivo, clinique)."@fr .
:SourceScientifique a owl:Class ; rdfs:subClassOf :ReferenceScientifique ; rdfs:label "Source scientifique"@fr ; rdfs:comment "Ajoutée : type du document dont provient l'information (article, thèse, rapport)."@fr .
:UsageTherapeutique a owl:Class ; rdfs:label "Usage thérapeutique"@fr ; rdfs:comment "Ajoutée : usage médicinal documenté (remplace Recette/Ingrédient/Remède d'origine sous une forme simplifiée)."@fr .
:Preparation a owl:Class ; rdfs:label "Préparation"@fr ; rdfs:comment "Ajoutée : préparation d'un usage médicinal."@fr .
:ComposeChimique a owl:Class ; rdfs:label "Composé chimique"@fr ; rdfs:comment "Ajoutée : composé chimique associé à une plante."@fr .
:ActivitePharmacologique a owl:Class ; rdfs:label "Activité pharmacologique"@fr ; rdfs:comment "Activité rapportée par une source ; ne constitue pas à elle seule une preuve d'efficacité clinique."@fr .
:EffetToxicologique a owl:Class ; rdfs:label "Effet toxicologique"@fr ; rdfs:comment "Effet ou risque toxicologique documenté, sans dépasser les conclusions de la source."@fr .
:EthniePraticienne a owl:Class ; rdfs:label "Communauté ethnolinguistique concernée"@fr ; rdfs:comment "Contexte culturel rapporté par une étude ; à distinguer de la langue du nom vernaculaire."@fr .
:SolvantEtExcipient a owl:Class ; rdfs:subClassOf :Preparation ; rdfs:label "Solvant ou excipient"@fr .
:ProcedeTransformation a owl:Class ; rdfs:subClassOf :Preparation ; rdfs:label "Procédé de transformation"@fr .
:FormeGalenique a owl:Class ; rdfs:subClassOf :Preparation ; rdfs:label "Forme galénique"@fr .
:ModeAdministration a owl:Class ; rdfs:label "Mode d'administration"@fr .

# Parties de plante complémentaires au modèle conservé.
:OrganeSouterrain a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Organe souterrain"@fr .
:OrganeAerien a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Organe aérien"@fr .
:Tubercule a owl:Class ; rdfs:subClassOf :OrganeSouterrain ; rdfs:label "Tubercule"@fr .
:Rhizome a owl:Class ; rdfs:subClassOf :OrganeSouterrain ; rdfs:label "Rhizome"@fr .
:Graine a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Graine"@fr .
:RameauFeuille a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Rameau feuillé"@fr .
:GommeSeve a owl:Class ; rdfs:subClassOf :PartieDePlante ; rdfs:label "Gomme ou sève"@fr .

# Catégories de préparation et de forme galénique (schéma, sans individus).
:Decoction a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Décoction"@fr .
:MacerationAqueuse a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Macération aqueuse"@fr .
:Trituration a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Trituration"@fr .
:Calcination a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Calcination"@fr .
:Infusion a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Infusion"@fr .
:Decocte a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Décocté"@fr .
:Macere a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Macéré"@fr .
:PoudreSeche a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Poudre sèche"@fr .
:Cataplasme a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Cataplasme"@fr .
:Pommade a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Pommade"@fr .
:Fumigation a owl:Class ; rdfs:subClassOf :FormeGalenique ; rdfs:label "Fumigation"@fr .

# Familles de composés et effets toxiques génériques, sans individus.
:MetaboliteSecondaire a owl:Class ; rdfs:subClassOf :ComposeChimique ; rdfs:label "Métabolite secondaire"@fr .
:Alcaloide a owl:Class ; rdfs:subClassOf :MetaboliteSecondaire ; rdfs:label "Alcaloïde"@fr .
:Flavonoide a owl:Class ; rdfs:subClassOf :MetaboliteSecondaire ; rdfs:label "Flavonoïde"@fr .
:Tanin a owl:Class ; rdfs:subClassOf :MetaboliteSecondaire ; rdfs:label "Tanin"@fr .
:Saponoside a owl:Class ; rdfs:subClassOf :MetaboliteSecondaire ; rdfs:label "Saponoside"@fr .
:ToxiciteHepatique a owl:Class ; rdfs:subClassOf :EffetToxicologique ; rdfs:label "Toxicité hépatique"@fr .
:ToxiciteNerveuse a owl:Class ; rdfs:subClassOf :EffetToxicologique ; rdfs:label "Toxicité nerveuse"@fr .

# --- Propriétés objet ajoutées (relations de rattachement et provenance) ---
:estDocumenteePar a owl:ObjectProperty ;
    rdfs:label "est documentée par"@fr ;
    rdfs:domain owl:Thing ;
    rdfs:range :SourceScientifique ;
    rdfs:comment "Relation générique de provenance : rattache une ressource ou une affirmation du graphe à la source scientifique qui la documente. Les propriétés plus spécifiques peuvent être conservées comme sous-propriétés."@fr .

:provientDe a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "provient de"@fr ;
    rdfs:domain :UsageTherapeutique ;
    rdfs:range :SourceScientifique ;
    rdfs:comment "Rattache explicitement un usage thérapeutique à sa source scientifique."@fr .
:estDocumenteeDans a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "est documentée dans"@fr ;
    rdfs:domain :Plante ;
    rdfs:range :SourceScientifique ;
    rdfs:comment "Relie une plante aux documents scientifiques qui la décrivent; sous-propriété de la relation générique de provenance."@fr .
:aPourNomVernaculaire a owl:ObjectProperty ; rdfs:label "a pour nom vernaculaire"@fr ; rdfs:domain :Plante ; rdfs:range :NomVernaculaire ; rdfs:comment "Ajoutée : rattache une plante à ses désignations locales."@fr .
:estLocaliseeA a owl:ObjectProperty ; rdfs:label "est localisée à"@fr ; rdfs:domain :Plante ; rdfs:range :Localite ; rdfs:comment "Ajoutée : associe une plante à sa localisation géographique."@fr .
:aPourNiveauDePreuve a owl:ObjectProperty ; rdfs:label "a pour niveau de preuve"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range :NiveauDePreuve ; rdfs:comment "Ajoutée : rattache un usage au niveau de preuve déclaré par sa source."@fr .
:aPourPartieUtilisee a owl:ObjectProperty ; rdfs:label "a pour partie utilisée"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range :PartieDePlante ; rdfs:comment "Relie un usage à la partie de plante explicitement rapportée par la source."@fr .
:aPourPreparation a owl:ObjectProperty ; rdfs:label "a pour préparation"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range :Preparation ; rdfs:comment "Relie un usage à sa préparation ou son procédé documenté."@fr .
:aPourMaladieCible a owl:ObjectProperty ; rdfs:label "a pour maladie cible"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range :Maladie ; rdfs:comment "Rattache un usage rapporté à la maladie ou indication correspondante."@fr .
:estRapportePour a owl:ObjectProperty ; rdfs:label "est rapportée pour"@fr ; rdfs:domain :Plante ; rdfs:range :UsageTherapeutique ; rdfs:comment "Associe une plante à un usage rapporté ; n'exprime pas une recommandation médicale."@fr .
:associeExcipient a owl:ObjectProperty ; rdfs:label "associe un solvant ou excipient"@fr ; rdfs:domain :Preparation ; rdfs:range :SolvantEtExcipient .
:sAdministrePar a owl:ObjectProperty ; rdfs:label "s'administre par"@fr ; rdfs:domain :Preparation ; rdfs:range :ModeAdministration .
:contientCompose a owl:ObjectProperty ; rdfs:label "contient ou est associée à un composé"@fr ; rdfs:domain :Plante ; rdfs:range :ComposeChimique ; rdfs:comment "À interpréter selon la méthode analytique rapportée par la source."@fr .
:presenteEffetToxicologique a owl:ObjectProperty ; rdfs:label "présente un effet toxicologique rapporté"@fr ; rdfs:domain :Plante ; rdfs:range :EffetToxicologique .
:presenteActivite a owl:ObjectProperty ; rdfs:label "présente une activité rapportée"@fr ; rdfs:domain :Plante ; rdfs:range :ActivitePharmacologique .
:estEmployeParEthnie a owl:ObjectProperty ; rdfs:label "est employée par la communauté"@fr ; rdfs:domain :Plante ; rdfs:range :EthniePraticienne ; rdfs:comment "À utiliser uniquement lorsque le contexte ethnobotanique est explicitement rapporté."@fr .

# Rattachements de provenance spécialisés. Leur inclusion dans la hiérarchie
# générique permet aux requêtes Neo4j de récupérer les sources de tous les types
# de faits sans effacer la sémantique particulière de chaque relation.
:estNomVernaculaireDocumentePar a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "nom vernaculaire documenté par"@fr ;
    rdfs:domain :NomVernaculaire ;
    rdfs:range :SourceScientifique .

:estActiviteDocumenteePar a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "activité pharmacologique documentée par"@fr ;
    rdfs:domain :ActivitePharmacologique ;
    rdfs:range :SourceScientifique .

:estComposeDocumentePar a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "composé documenté par"@fr ;
    rdfs:domain :ComposeChimique ;
    rdfs:range :SourceScientifique .

:estEffetToxicologiqueDocumentePar a owl:ObjectProperty ;
    rdfs:subPropertyOf :estDocumenteePar ;
    rdfs:label "effet toxicologique documenté par"@fr ;
    rdfs:domain :EffetToxicologique ;
    rdfs:range :SourceScientifique .

# --- Propriétés de données ajoutées ---
:nomMoore a owl:DatatypeProperty ; rdfs:label "nom en mooré"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:nomDioula a owl:DatatypeProperty ; rdfs:label "nom en dioula"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:nomFulfulde a owl:DatatypeProperty ; rdfs:label "nom en fulfuldé"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:niveauPreuve a owl:DatatypeProperty ; rdfs:label "niveau de preuve"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée : valeur rapportée par la source."@fr .
:typeEtude a owl:DatatypeProperty ; rdfs:label "type d'étude"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:source a owl:DatatypeProperty ; rdfs:label "source"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée : traçabilité documentaire."@fr .
:doi a owl:DatatypeProperty ; rdfs:label "DOI"@fr ; rdfs:domain :SourceScientifique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:page a owl:DatatypeProperty ; rdfs:label "page"@fr ; rdfs:domain :SourceScientifique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:section a owl:DatatypeProperty ; rdfs:label "section"@fr ; rdfs:domain :SourceScientifique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée."@fr .
:dosage a owl:DatatypeProperty ; rdfs:label "dosage"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Ajoutée : précautions d'emploi documentées par la source."@fr .
:toxicite a owl:DatatypeProperty ; rdfs:label "toxicité"@fr ; rdfs:domain :Plante ; rdfs:range xsd:string ; rdfs:comment "Ajoutée : précautions d'emploi documentées par la source."@fr .
:nomVernaculaireTexte a owl:DatatypeProperty ; rdfs:label "forme textuelle du nom vernaculaire"@fr ; rdfs:domain :NomVernaculaire ; rdfs:range xsd:string .
:codeLangue a owl:DatatypeProperty ; rdfs:label "code de langue"@fr ; rdfs:domain :NomVernaculaire ; rdfs:range xsd:string ; rdfs:comment "Code de langue fourni par la source ou un référentiel identifié."@fr .
:descriptionActivite a owl:DatatypeProperty ; rdfs:label "description de l'activité pharmacologique"@fr ; rdfs:domain :ActivitePharmacologique ; rdfs:range xsd:string .
:effetToxicologique a owl:DatatypeProperty ; rdfs:label "effet toxicologique rapporté"@fr ; rdfs:domain :EffetToxicologique ; rdfs:range xsd:string .

# ============================================================================
# ───────────── ENRICHISSEMENT DU SCHÉMA (v4.0) : MODES D'ADMINISTRATION,
# ───────────── MODES DE PRÉPARATION, POSOLOGIE, LOCALISATION, PARTIES
# ============================================================================

# --- Sous-classes de :ModeAdministration (11 modes rencontrés dans les sources) ---
:VoieOrale a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Voie orale"@fr ; rdfs:comment "Boisson, ingestion, absorption orale."@fr .
:BainCorporel a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Bain"@fr .
:BainDeSiege a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Bain de siège"@fr .
:ApplicationLocale a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Application locale (externe)"@fr ; rdfs:comment "Application sur la peau ou la zone atteinte, y compris pulvérisation."@fr .
:MassageOuFriction a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Massage ou friction"@fr .
:LavementRectal a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Lavement (voie rectale)"@fr ; rdfs:comment "Inclut les « injections rectales » mentionnées par les sources."@fr .
:AdministrationParFumigation a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Fumigation"@fr ; rdfs:comment "Mode d'administration ; à distinguer de la forme galénique :Fumigation."@fr .
:Inhalation a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Inhalation"@fr .
:Instillation a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Instillation (nasale ou oculaire)"@fr .
:Gargarisme a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Gargarisme"@fr .
:UsagePurgatif a owl:Class ; rdfs:subClassOf :ModeAdministration ; rdfs:label "Usage purgatif"@fr ; rdfs:comment "Terme employé par les sources ; la voie précise n'est pas indiquée."@fr .

# --- Sous-classes de :ModeDePreparation ajoutées ---
:ReductionEnPoudre a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Réduction en poudre"@fr .
:PreparationDeCataplasme a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Préparation de cataplasme"@fr .
:Mastication a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Mastication"@fr .
:Extraction a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Extraction"@fr .
:PreparationDeJus a owl:Class ; rdfs:subClassOf :ModeDePreparation ; rdfs:label "Préparation de jus"@fr .

# --- Unification des deux hiérarchies de préparation ---
:aPourModeDePreparation a owl:ObjectProperty ; rdfs:label "a pour mode de préparation"@fr ; rdfs:domain :Preparation ; rdfs:range :ModeDePreparation ; rdfs:comment "Relie une préparation à ses procédés (décoction, macération, ...). Plusieurs valeurs possibles."@fr .
:associePlante a owl:ObjectProperty ; rdfs:label "associe une autre plante"@fr ; rdfs:domain :Preparation ; rdfs:range :Plante ; rdfs:comment "Recette combinée : plante citée par la source comme associée à celle de l'usage (dans une ou plusieurs recettes)."@fr .
:aPourModeAdministration a owl:ObjectProperty ; rdfs:label "a pour mode d'administration"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range :ModeAdministration ; rdfs:comment "Un usage peut avoir plusieurs modes (ex. boisson et bain). Aucun lien n'est créé quand la source ne précise pas le mode pour l'usage concerné."@fr .

# --- Posologie et détails de préparation ---
:frequenceAdministration a owl:DatatypeProperty ; rdfs:label "fréquence d'administration"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Ex. matin et soir. À ne pas confondre avec la fréquence de citation."@fr .
:frequenceCitation a owl:DatatypeProperty ; rdfs:label "fréquence de citation"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Nombre ou proportion de citations dans l'enquête (pas une dose)."@fr .
:dureeTraitement a owl:DatatypeProperty ; rdfs:label "durée du traitement"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string .
:etatPlante a owl:DatatypeProperty ; rdfs:label "état de la plante"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Frais, cru ou séché, tel que rapporté."@fr .
:precautionEmploi a owl:DatatypeProperty ; rdfs:label "précaution d'emploi"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string .
:modeAdministrationTexte a owl:DatatypeProperty ; rdfs:label "mode d'administration (texte source)"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Formulation d'origine, conservée pour traçabilité."@fr .
:partiesRapportees a owl:DatatypeProperty ; rdfs:label "parties utilisées (texte source)"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string .
:passageSource a owl:DatatypeProperty ; rdfs:label "passage de la source"@fr ; rdfs:domain :UsageTherapeutique ; rdfs:range xsd:string ; rdfs:comment "Citation courte du passage justifiant l'usage."@fr .
:procedeRapporte a owl:DatatypeProperty ; rdfs:label "procédé (texte source)"@fr ; rdfs:domain :Preparation ; rdfs:range xsd:string .
:formeRapportee a owl:DatatypeProperty ; rdfs:label "forme obtenue (texte source)"@fr ; rdfs:domain :Preparation ; rdfs:range xsd:string .
:ingredientsRapportes a owl:DatatypeProperty ; rdfs:label "solvants, excipients et ingrédients (texte source)"@fr ; rdfs:domain :Preparation ; rdfs:range xsd:string .

